from fastapi import FastAPI
from fastapi.responses import HTMLResponse
from pydantic import BaseModel

app = FastAPI()

current_product = {
    "title": "Instagram Business Starter Kit",
    "score": "88/100",
    "price": "₹299",
    "cost": "₹0",
    "recommendation": "High Demand, Low Trust Risk",
    "status": "PENDING APPROVAL ⏳"
}

class ActionRequest(BaseModel):
    action: str

@app.get("/", response_class=HTMLResponse)
def home():
    return f"""
    <!DOCTYPE html>
    <html>
    <head>
        <meta charset="UTF-8">
        <title>Autonomous Business OS</title>
        <style>
            body {{ font-family: 'Segoe UI', sans-serif; background-color: #0f172a; color: #f8fafc; padding: 40px; display: flex; flex-direction: column; align-items: center; }}
            .container {{ max-width: 600px; width: 100%; background: #1e293b; border-radius: 12px; padding: 24px; border: 1px solid #334155; }}
            h1 {{ color: #38bdf8; font-size: 22px; margin-top: 0; }}
            .badge {{ background: #10b981; color: white; padding: 4px 10px; border-radius: 99px; font-size: 12px; font-weight: bold; }}
            .card {{ background: #0f172a; border-radius: 8px; padding: 16px; margin-top: 15px; border: 1px solid #475569; }}
            .status-box {{ background: #334155; padding: 6px 12px; border-radius: 6px; font-weight: bold; color: #f59e0b; display: inline-block; }}
            .btn-group {{ margin-top: 20px; display: flex; gap: 10px; }}
            button {{ padding: 10px 18px; border: none; border-radius: 6px; font-weight: bold; cursor: pointer; font-size: 14px; }}
            .btn-app {{ background: #10b981; color: white; }}
            .btn-rej {{ background: #ef4444; color: white; }}
        </style>
    </head>
    <body>
        <div class="container">
            <span class="badge">● SYSTEM ONLINE</span>
            <h1>🚀 Autonomous Business OS</h1>
            <div class="card">
                <p><strong>Product Idea:</strong> {current_product["title"]}</p>
                <p><strong>Opportunity Score:</strong> <span style="color:#10b981">{current_product["score"]}</span></p>
                <p><strong>Price:</strong> {current_product["price"]} | <strong>Cost:</strong> {current_product["cost"]}</p>
                <p><strong>Status:</strong> <span id="status-display" class="status-box">{current_product["status"]}</span></p>
                <div class="btn-group">
                    <button class="btn-app" onclick="sendDecision('APPROVED ✅')">APPROVE ✅</button>
                    <button class="btn-rej" onclick="sendDecision('REJECTED ❌')">REJECT ❌</button>
                </div>
            </div>
        </div>
        <script>
            async function sendDecision(act) {{
                const res = await fetch('/api/decision', {{
                    method: 'POST',
                    headers: {{ 'Content-Type': 'application/json' }},
                    body: JSON.stringify({{ action: act }})
                }});
                const data = await res.json();
                const el = document.getElementById('status-display');
                el.innerText = data.new_status;
                el.style.color = act.includes('APPROVED') ? '#10b981' : '#ef4444';
            }}
        </script>
    </body>
    </html>
    """

@app.post("/api/decision")
def process_decision(req: ActionRequest):
    current_product["status"] = req.action
    return {"status": "success", "new_status": req.action}